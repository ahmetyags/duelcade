# Local simulator/web:
EXPO_PUBLIC_GAME_SERVER_URL=http://localhost:2567

# Physical devices must use your computer's LAN IP while developing:
# EXPO_PUBLIC_GAME_SERVER_URL=http://192.168.1.50:2567

# Production uses HTTPS so the SDK upgrades connections to secure WebSockets:
# EXPO_PUBLIC_GAME_SERVER_URL=https://duelcade-game-server.onrender.com

# Optional crash reporting. Reports are sent only after the player enables
# "Share Crash Reports" in Settings.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
