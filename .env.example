# Local simulator/web:
EXPO_PUBLIC_GAME_SERVER_URL=http://localhost:2567

# Firebase Console > Project settings > Your apps > Web app.
# These are public client identifiers. Never use a service-account private key
# in an EXPO_PUBLIC variable.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native social login OAuth clients. Web uses Firebase's popup flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# Physical devices must use your computer's LAN IP while developing:
# EXPO_PUBLIC_GAME_SERVER_URL=http://192.168.1.50:2567

# Production uses HTTPS so the SDK upgrades connections to secure WebSockets:
# EXPO_PUBLIC_GAME_SERVER_URL=https://duelcade-game-server.onrender.com

# Optional crash reporting. Reports are sent only after the player enables
# "Share Crash Reports" in Settings.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
