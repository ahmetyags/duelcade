{
  "name": "duelcade",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web:production": "expo export --platform web --clear --output-dir dist",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:typecheck": "tsc --project server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "audit:ci": "node scripts/audit-ci.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run server:typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.83.0",
    "colyseus": "^0.17.10",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-build-properties": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "1.17.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "axios": "1.13.2"
  }
}
